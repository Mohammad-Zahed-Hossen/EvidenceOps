# Application
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=evidenceops_chunks_bge_small_v1
QDRANT_TIMEOUT_SECONDS=10

# Generation (Ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_TEMPERATURE=0.0

# Embedding (FastEmbed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_DISTANCE=Cosine
EMBEDDING_THREADS=4
EMBEDDING_BATCH_SIZE=8

# Reranking & Retrieval
FLASHRANK_MODEL=ms-marco-TinyBERT-L-2-v2
RRF_K=60
TOP_K_SPARSE=20
TOP_K_DENSE=20
TOP_K_HYBRID=20
TOP_K_CONTEXT=6

# Controller & Bounded Retrieval Limits
MAX_ITERATIONS=3
MAX_RETRIEVAL_CALLS=3
MAX_CONTEXT_CHARS=24000
SUFFICIENCY_THRESHOLD=0.72
ABSTAIN_THRESHOLD=0.35

# Observability & Tracing (OpenTelemetry & Jaeger)
OTEL_SERVICE_NAME=evidenceops-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SIMULATED_CLOUD_INPUT_COST_USD_PER_1K=0.0000
SIMULATED_CLOUD_OUTPUT_COST_USD_PER_1K=0.0000
