# Application
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8080

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=evidenceops_chunks_bge_small_v1
QDRANT_TIMEOUT_SECONDS=10

# Generation (Default: Ollama; Optional: Local OpenAI-compatible server such as LM Studio or vLLM)
GENERATOR_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_TEMPERATURE=0.0
OLLAMA_MAX_TOKENS=256

# Optional Local OpenAI-compatible Endpoint (used when GENERATOR_PROVIDER=openai_compatible)
# Strictly restricted to local loopback HTTP (127.0.0.1 or localhost); external URLs, HTTPS, and API keys are rejected.
OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1
OPENAI_COMPATIBLE_MODEL=local-model
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=60
OPENAI_COMPATIBLE_MAX_TOKENS=256

# Embedding (FastEmbed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_DISTANCE=Cosine
EMBEDDING_THREADS=4
EMBEDDING_BATCH_SIZE=8

# Reranking & Retrieval
FLASHRANK_MODEL=ms-marco-TinyBERT-L-2-v2
RRF_K=60
TOP_K_SPARSE=20
TOP_K_DENSE=20
TOP_K_HYBRID=20
TOP_K_CONTEXT=6

# Controller & Bounded Retrieval Limits
MAX_ITERATIONS=3
MAX_RETRIEVAL_CALLS=3
MAX_CONTEXT_CHARS=24000
SUFFICIENCY_THRESHOLD=0.72
ABSTAIN_THRESHOLD=0.35
CONFLICT_THRESHOLD=0.60

# Observability & Tracing (OpenTelemetry & Jaeger)
OTEL_SERVICE_NAME=evidenceops-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SIMULATED_CLOUD_INPUT_COST_USD_PER_1K=0.0000
SIMULATED_CLOUD_OUTPUT_COST_USD_PER_1K=0.0000

# Phase 5 API & Dashboard Concurrency Limits
API_MAX_CONCURRENT_QUERIES=1
API_MAX_CONCURRENT_EVALUATIONS=1
API_RUN_HISTORY_LIMIT=100
API_EVALUATION_ROOT=eval/runs

# Phase L3 LiteBridge Optional Web Retrieval (Disabled by default)
LITEBRIDGE_ENABLE_TAVILY_WEB=false
TAVILY_API_KEY=
LITEBRIDGE_WEB_TIMEOUT_MS=5000
LITEBRIDGE_WEB_MAX_RESULTS=5
LITEBRIDGE_WEB_CACHE_TTL_SECONDS=300
LITEBRIDGE_WEB_CACHE_MAX_ENTRIES=64

# Phase L5 LiteBridge Optional Generation Providers (Disabled by default)
# Local providers, disabled unless explicitly enabled
LITEBRIDGE_ENABLE_OLLAMA=false
LITEBRIDGE_OLLAMA_BASE_URL=http://127.0.0.1:11434
LITEBRIDGE_OLLAMA_MODEL=qwen2.5:1.5b

LITEBRIDGE_ENABLE_LOCAL_OPENAI_COMPATIBLE=false
LITEBRIDGE_LOCAL_OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:8000
LITEBRIDGE_LOCAL_OPENAI_COMPATIBLE_MODEL=
LITEBRIDGE_LOCAL_OPENAI_COMPATIBLE_API_KEY=

# Hosted providers, disabled unless explicitly enabled (Examples only; required nonblank when enabled)
LITEBRIDGE_ENABLE_OPENAI=false
OPENAI_API_KEY=
LITEBRIDGE_OPENAI_MODEL=

LITEBRIDGE_ENABLE_ANTHROPIC=false
ANTHROPIC_API_KEY=
LITEBRIDGE_ANTHROPIC_MODEL=

LITEBRIDGE_ENABLE_GEMINI=false
GEMINI_API_KEY=
LITEBRIDGE_GEMINI_MODEL=

# Phase L7 LiteBridge Interfaces (Disabled by default)
LITEBRIDGE_ENABLE_INTERFACES=false
LITEBRIDGE_INTERFACE_PACKAGE_TTL_SECONDS=300
LITEBRIDGE_INTERFACE_PACKAGE_MAX_ENTRIES=64
LITEBRIDGE_INTERFACE_ALLOW_EXTERNAL_RETRIEVAL=false
LITEBRIDGE_INTERFACE_ALLOW_EXTERNAL_GENERATION=false
LITEBRIDGE_INTERFACE_ALLOW_PRIVATE_EVIDENCE_EXPORT=false
